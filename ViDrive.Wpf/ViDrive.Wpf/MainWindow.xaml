<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="ViDrive.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ViDrive" Height="720" Width="1280">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="240"/>
        </Grid.ColumnDefinitions>

        <!-- 왼쪽: Unity 렌더링 영역 (테두리 + 여백으로 감싸서 창 가장자리와 붙지 않게) -->
        <Border Grid.Column="0"
                Margin="0,0,10,0"
                BorderBrush="#FF666666"
                BorderThickness="1"
                Background="Black">
            <Grid x:Name="UnityContainer" Margin="1"/>
        </Border>

        <!-- 오른쪽: 컨트롤 패널 (임시 자리배치용, 아직 기능 연결 없음) -->
        <StackPanel Grid.Column="1" Orientation="Vertical">
            <TextBlock Text="아바타 제어" FontWeight="Bold" FontSize="14" Margin="0,0,0,12"/>

            <Button Content="VRM 파일 불러오기" Height="32" Margin="0,0,0,16"/>

            <TextBlock Text="위치 X" Margin="0,0,0,2"/>
            <Slider Minimum="-5" Maximum="5" Value="0" Margin="0,0,0,10"/>

            <TextBlock Text="위치 Y" Margin="0,0,0,2"/>
            <Slider Minimum="-5" Maximum="5" Value="0" Margin="0,0,0,10"/>

            <TextBlock Text="위치 Z" Margin="0,0,0,2"/>
            <Slider Minimum="-5" Maximum="5" Value="0" Margin="0,0,0,10"/>

            <TextBlock Text="회전 (Y축)" Margin="0,0,0,2"/>
            <Slider Minimum="0" Maximum="360" Value="0" Margin="0,0,0,10"/>

            <TextBlock Text="크기" Margin="0,0,0,2"/>
            <Slider Minimum="0.1" Maximum="3" Value="1" Margin="0,0,0,20"/>

            <Button Content="배경 투명 송출 시작" Height="32"/>
        </StackPanel>
    </Grid>
</Window>
